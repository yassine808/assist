{
  "name": "riotswitcher",
  "version": "3.1.4",
  "description": "Riot Account Manager — Switch between Riot accounts instantly",
  "main": "out/main/index.js",
  "author": "Yassine",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:electron": "electron-vite dev",
    "dev:python": "python src/backend/main.py --dev",
    "embed:env": "node build/embed-env.mjs",
    "prebuild": "node build/embed-env.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:py": "pyinstaller build/build-python.spec --noconfirm --distpath release --workpath build/pyinstaller",
    "dist": "npm run build && npm run build:py && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check:api-leaks": "node scripts/check-api-leaks.mjs",
    "lint": "eslint src/renderer/src/ src/main/",
    "lint:fix": "eslint src/renderer/src/ src/main/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"*.{json,mjs,ts}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"*.{json,mjs,ts}\" \".github/**/*.{yml,yaml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:py": "python -m pytest tests/",
    "test:all": "npm run test && npm run test:py"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "@vitest/coverage-v8": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "jsdom": "^30.1.1",
    "lucide-react": "^0.525.0",
    "postcss": "^8.5.0",
    "prettier": "^3.9.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "minimatch@>=10": {
      "brace-expansion": "^5.0.12"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "electron-winstaller": true
  }
}
