<Window x:Class="AccountSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account Switcher" Height="560" Width="820"
        Background="#16181B" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9AA0A6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="8,3">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22262B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonActive" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#FF4655" CornerRadius="6" Margin="8,3">
                            <ContentPresenter Margin="16,12" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FF4655"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#2B2F35"/>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1F2226"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#33373D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style x:Key="CardListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#D7D9DC"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#0A0B0C" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Grid.Row="0" Background="#111315" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="ACCOUNT SWITCHER" Foreground="#7A8087" FontSize="11" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#xE921;" Width="40" Height="36" Background="Transparent" Foreground="#9AA0A6"
                            BorderThickness="0" FontFamily="Segoe MDL2 Assets" Click="Minimize_Click"/>
                    <Button Content="&#xE8BB;" Width="40" Height="36" Background="Transparent" Foreground="#9AA0A6"
                            BorderThickness="0" FontFamily="Segoe MDL2 Assets" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <StackPanel Grid.Column="0" Background="#111315">
                    <TextBlock Text="ASSIST-LITE" Foreground="#FF4655" FontSize="16" FontWeight="Black"
                               Margin="18,20,0,20"/>
                    <Button x:Name="NavAccounts" Content="Accounts" Style="{StaticResource NavButtonActive}"
                            Click="NavAccounts_Click"/>
                    <Button x:Name="NavStore" Content="Store" Style="{StaticResource NavButton}"
                            Click="NavStore_Click"/>
                    <Button x:Name="NavLive" Content="Live Game" Style="{StaticResource NavButton}"
                            Click="NavLive_Click"/>
                </StackPanel>

                <!-- Content -->
                <Grid Grid.Column="1" Background="#1B1E22" Margin="0">

                    <!-- Accounts panel -->
                    <Grid x:Name="AccountsPanel" Margin="24" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Accounts" Foreground="White" FontSize="20"
                                   FontWeight="Bold" Margin="0,0,0,16"/>

                        <ListBox Grid.Row="1" x:Name="AccountsList" Style="{StaticResource CardListBox}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12" Margin="0,4" Background="#22262B" CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                       VerticalAlignment="Center" Foreground="White" FontSize="14"/>
                                            <Button Grid.Column="1" Content="Switch" Margin="6,0"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Click="SwitchButton_Click" Tag="{Binding}"/>
                                            <Button Grid.Column="2" Content="Remove"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Click="RemoveButton_Click" Tag="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Margin="0,16,0,0">
                            <TextBox x:Name="DisplayNameBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,8"
                                     Tag="Display name (e.g. Main, Smurf)"/>
                            <TextBox x:Name="SsidBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,8"
                                     Tag="Paste ssid cookie value"/>
                            <Button Content="Add Account" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Stretch" Click="AddButton_Click"/>
                            <TextBlock x:Name="StatusText" Foreground="#8A9099" Margin="0,10,0,0"
                                       TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <!-- Store panel -->
                    <Grid x:Name="StorePanel" Margin="24" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Store" Foreground="White" FontSize="20"
                                   FontWeight="Bold" Margin="0,0,0,16"/>
                        <Button Grid.Row="1" Content="Refresh Store" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Click="RefreshStore_Click"/>
                        <ListBox Grid.Row="2" x:Name="StoreList" Style="{StaticResource CardListBox}" Margin="0,16,0,0"/>
                    </Grid>

                    <!-- Live game panel -->
                    <Grid x:Name="LivePanel" Margin="24" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Live Game" Foreground="White" FontSize="20"
                                   FontWeight="Bold" Margin="0,0,0,16"/>
                        <Button Grid.Row="1" Content="Refresh Live Game" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Click="RefreshLiveGame_Click"/>
                        <ListBox Grid.Row="2" x:Name="LiveGameList" Style="{StaticResource CardListBox}" Margin="0,16,0,0"/>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
