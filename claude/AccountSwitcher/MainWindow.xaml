<Window x:Class="AccountSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account Switcher" Height="480" Width="360"
        Background="#1E2124" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#5865F2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <TabControl Background="Transparent" BorderThickness="0" Margin="16">
        <TabItem Header="Accounts">
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0" x:Name="AccountsList" Background="#2B2E33" BorderThickness="0"
                          Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Margin="0,4" Background="#33373D" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                               VerticalAlignment="Center" Foreground="White" FontSize="14"/>
                                    <Button Grid.Column="1" Content="Switch" Margin="6,0"
                                            Click="SwitchButton_Click" Tag="{Binding}"/>
                                    <Button Grid.Column="2" Content="Remove" Background="#4A4D52"
                                            Click="RemoveButton_Click" Tag="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBox x:Name="DisplayNameBox" Margin="0,0,0,6" Padding="6"
                             Tag="Display name (e.g. Main, Smurf)"/>
                    <TextBox x:Name="SsidBox" Margin="0,0,0,6" Padding="6"
                             Tag="Paste ssid cookie value"/>
                    <Button Content="Add Account" HorizontalAlignment="Stretch" Padding="10"
                            Click="AddButton_Click"/>
                    <TextBlock x:Name="StatusText" Foreground="#B5B8BC" Margin="0,8,0,0"
                               TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Store">
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Content="Refresh Store" HorizontalAlignment="Stretch"
                        Padding="10" Click="RefreshStore_Click"/>
                <ListBox Grid.Row="1" x:Name="StoreList" Margin="0,10,0,0" Background="#2B2E33"
                         BorderThickness="0" Foreground="White"/>
            </Grid>
        </TabItem>

        <TabItem Header="Live Game">
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Content="Refresh Live Game" HorizontalAlignment="Stretch"
                        Padding="10" Click="RefreshLiveGame_Click"/>
                <ListBox Grid.Row="1" x:Name="LiveGameList" Margin="0,10,0,0" Background="#2B2E33"
                         BorderThickness="0" Foreground="White"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
