<Window x:Class="AccountSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account Switcher" Height="480" Width="360"
        Background="#1E2124" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#5865F2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Accounts" FontSize="20" FontWeight="Bold"
                   Foreground="White" Margin="0,0,0,12"/>

        <ListBox Grid.Row="1" x:Name="AccountsList" Background="#2B2E33" BorderThickness="0"
                  Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,4" Background="#33373D" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                       VerticalAlignment="Center" Foreground="White" FontSize="14"/>
                            <Button Grid.Column="1" Content="Switch" Margin="6,0"
                                    Click="SwitchButton_Click" Tag="{Binding}"/>
                            <Button Grid.Column="2" Content="Remove" Background="#4A4D52"
                                    Click="RemoveButton_Click" Tag="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBox x:Name="DisplayNameBox" Margin="0,0,0,6" Padding="6"
                     Tag="Display name (e.g. Main, Smurf)"/>
            <TextBox x:Name="SsidBox" Margin="0,0,0,6" Padding="6"
                     Tag="Paste ssid cookie value"/>
            <Button Content="Add Account" HorizontalAlignment="Stretch" Padding="10"
                    Click="AddButton_Click"/>
            <TextBlock x:Name="StatusText" Foreground="#B5B8BC" Margin="0,8,0,0"
                       TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>
